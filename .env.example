########################################################
#                   Github related credentials         #
########################################################
# requied; if your github username is ABC, then set YOUR_ORG=ABC
YOUR_ORG=""

# requied; should be a personal access token 
# refer to https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens#creating-a-fine-grained-personal-access-token
GH_TOKEN=""


########################################################
#                   LLM provider API key(s)            #
########################################################
# LLM provider API key(s) — set the one(s) for the model you run; LiteLLM reads them directly.
# List the same variable in your agent's forward_env so it reaches the run container.
OPENAI_API_KEY=""          # gpt-*, o-series
ANTHROPIC_API_KEY=""       # claude-*
# GEMINI_API_KEY / MISTRAL_API_KEY / GROQ_API_KEY / XAI_API_KEY — as your model needs

# IF you do not have the direct api key, you can use the gateway key instead.
# then put the name "MY_GATEWAY_API_KEY" verbatim in the config file and set the provider to gateway.
# MT_GATEWAY_API_KEY=""


########################################################
#                   Hugging Face Hub                    #
########################################################

# disable Hugging Face Hub offline mode for local development
HF_HUB_OFFLINE=1 

########################################################
#                    benchmark cache                   #
########################################################
# Required even without the xrlenv rollout infrastructure.
# Relative paths resolve from the project root.
XRLENV_BENCHMARK_CACHE=.cache/xrlenv_benchmark_cache


########################################################
#                   xrlenv rollout infrastructure      #
########################################################
# configure below only if you are using the xrlenv rollout infrastructure
# obtain the xrlenv-related credentials from the xrlenv admin
# e.g. 192.0.2.1
XRLENV_GRPC_HOST=""
# e.g. 50051
XRLENV_GRPC_PORT=""
# e.g. 1234567890
XRLENV_CONSUMER_TOKEN=""

