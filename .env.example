# obtain the xrlenv-related credentials from the xrlenv admin
XRLENV_GRPC_HOST=<fill-the-ip-of-the-xrlenv-grpc-host>
XRLENV_GRPC_PORT=<fill-the-port-of-the-xrlenv-grpc-host>
XRLENV_CONSUMER_TOKEN=<fill-the-consumer-token>
XRLENV_BENCHMARK_CACHE=<fill-the-path>

# GITHUB related credentials
YOUR_ORG=<fill-the-github-organization>
GH_TOKEN=<fill-the-github-token; should be a personal access token with repo scope>

# LLM provider API key(s) — set the one(s) for the model you run; LiteLLM reads them directly.
# List the same variable in your agent's forward_env so it reaches the run container.
OPENAI_API_KEY=<your-openai-key>          # gpt-*, o-series
ANTHROPIC_API_KEY=<your-anthropic-key>    # claude-*
# GEMINI_API_KEY / MISTRAL_API_KEY / GROQ_API_KEY / XAI_API_KEY — as your model needs



