# xrlenv_plugins/sysbox/pin.env — the single source of truth for what we build.
#
# Sourced by build_sysbox.sh and install_sysbox_node.sh. Change these together
# with a fresh SHA256SUMS (regenerate via build_sysbox.sh) — never edit a
# checksum by hand.

# The packaged sysbox-ce release we install for its systemd units, sysctls,
# ``sysbox`` subuid/subgid user setup, and daemon.json runtime merge. The
# release's *binaries* are then overlaid with the patched build below.
SYSBOX_CE_VERSION="0.7.0"

# The sysbox git ref whose sysbox-runc submodule carries the containerd
# compatibility fix (nestybox/sysbox-runc PR #106 — "add time namespace to sys
# container by default"). This is what makes sysbox usable on Docker 29.x /
# containerd 2.x; the packaged 0.7.0 release does NOT have it (see README, and
# upstream issue nestybox/sysbox#1011).
#
# Pinned to the sysbox-runc submodule commit validated in the 2026-07-05
# de-risk. Bump ONLY to a packaged sysbox-ce release that ships the fix (then
# this whole vendored-binary path can be retired), or to a newer verified
# sysbox-runc commit.
#
# NOTE (2026-08-08): sysbox-ce v0.7.1 (2026-07-31) DOES contain this commit —
# cf83133d is an ancestor of the sysbox-runc it ships — so the retirement
# condition above is now met and this vendored path can go away once 0.7.1 is
# validated on our Docker 29.x nodes. Until then we keep building the pinned
# commit, because 0.7.1 is otherwise untested here.
SYSBOX_RUNC_COMMIT="cf83133d"

# The PARENT nestybox/sysbox commit to build from. This must be pinned too, not
# just the submodule above: the parent supplies the containerized build
# toolchain AND records the other submodules (sysbox-fs / -mgr / -libs / -ipc).
# Building today's parent against a months-old sysbox-runc mixes eras — the
# newer siblings' go.mod pulls a newer Go toolchain, which then rejects the
# pinned runc's go.mod with "updates to go.mod needed" (exactly what broke the
# 2026-08-08 build on cn).
#
# 23f33570 is the NEWEST parent commit that still records sysbox-runc
# ${SYSBOX_RUNC_COMMIT}, so it carries the most build/test fixes while keeping
# the validated runtime. Bump it together with SYSBOX_RUNC_COMMIT: pick a parent
# whose recorded sysbox-runc equals the pin (build_sysbox.sh asserts this).
SYSBOX_PARENT_COMMIT="23f33570"

# The three static binaries the containerized build produces + overlays.
SYSBOX_BINARIES="sysbox-runc sysbox-mgr sysbox-fs"

# Where the vendored binaries live — SHARED storage, deliberately OUT of the git
# tree. A ~40 MB unofficial build has no business in-tree, and holding it in both
# the dev and prod repos would duplicate + invite drift. build_sysbox.sh writes
# to ``${SYSBOX_VENDOR_ROOT}/<commit>/``; install/deploy read from there.
#
# The location is CLUSTER-SPECIFIC — the shared filesystem is laid out differently
# per cluster — so there is NO default. Set ``XRLENV_SYSBOX_VENDOR_DIR`` (in .env)
# to the shared-storage root for the vendored binaries; build_sysbox.sh writes to
# ``${XRLENV_SYSBOX_VENDOR_DIR}/<commit>/`` and install/deploy read from there. It
# must resolve identically on the login node (where build_sysbox.sh runs) and on
# the pool nodes (where install_sysbox_node.sh runs under sudo, which drops the
# env var) — so point it at a path visible from both (e.g. a shared /fsx mount).
#
# ``SYSBOX_VENDOR_ROOT`` is this file's OUTPUT, not an input — the assignment below
# overwrites anything inherited — so setting it in ``.env`` looks plausible but
# does nothing. Warn rather than silently discard config the operator wrote.
if [ -n "${SYSBOX_VENDOR_ROOT:-}" ]; then
    printf 'WARNING: SYSBOX_VENDOR_ROOT=%s is set in the environment but is NOT read — it is an output of pin.env. Use XRLENV_SYSBOX_VENDOR_DIR instead (this value is being ignored).\n' \
        "${SYSBOX_VENDOR_ROOT}" >&2
fi
if [ -z "${XRLENV_SYSBOX_VENDOR_DIR:-}" ]; then
    printf 'ERROR: XRLENV_SYSBOX_VENDOR_DIR is not set. Set it (in .env) to a shared-storage\n' >&2
    printf '       directory for the vendored sysbox binaries — cluster-specific, no default,\n' >&2
    printf '       e.g. /path/to/xrlenv_sysbox_vendor. See xrlenv_plugins/sysbox/README.md.\n' >&2
    return 1 2>/dev/null || exit 1
fi
SYSBOX_VENDOR_ROOT="${XRLENV_SYSBOX_VENDOR_DIR}"
SYSBOX_VENDOR_SOURCE="override"

# Where the built set for the current pin must live. Callers check
# ``${SYSBOX_VENDOR_DIR}/SHA256SUMS`` to decide whether a build has been run on
# THIS cluster — see the pre-flight gate in the generated deploy scripts.
SYSBOX_VENDOR_DIR="${SYSBOX_VENDOR_ROOT}/${SYSBOX_RUNC_COMMIT}"
