# xrlenv environment — copy to .env and fill in what you need.
# Auto-loaded into os.environ on `import xrlenv` (shell-exported values win;
# disable with XRLENV_DOTENV=off). .env is gitignored — don't commit real values.

# ── Cheat sheet (the keys most setups touch) ─────────────────────────────
# XRLENV_GRPC_HOST=            XRLENV_GRPC_PORT=50051
# XRLENV_CONSUMER_TOKEN=       XRLENV_OPERATOR_TOKEN=      XRLENV_NODE_TOKEN=
# XRLENV_HOME=~/.xrlenv        XRLENV_BENCHMARK_CACHE=
# DOCKERHUB_USER=             DOCKERHUB_TOKEN=
# Mirror  (:5010): XRLENV_MIRROR_REGISTRY_{HOST,PORT,STORAGE}
# Private (:5011): XRLENV_PRIVATE_REGISTRY_{HOST,PORT,STORAGE}
# Scratch (:5012): XRLENV_SCRATCH_REGISTRY_{HOST,PORT,STORAGE}

# ── Consumer (SDK / drop-in / smokes) ────────────────────────────────────
XRLENV_HOME=~/.xrlenv

# Where the control-plane gRPC server is reachable FROM this host (use
# 127.0.0.1 for same-host or an SSH/port-forward terminating on loopback).
XRLENV_GRPC_HOST=<your control-plane IP>
XRLENV_GRPC_PORT=50051

# Bearer tokens — required once the control plane has issued any. Mint with
# `xrlenv tokens issue <role>` on the CP (consumer = SDK/drop-in/from_env;
# operator = admin writes / `xrlenv build apply`; node = agents dialing the CP).
XRLENV_CONSUMER_TOKEN=<your consumer token>
XRLENV_OPERATOR_TOKEN=<your operator token>
XRLENV_NODE_TOKEN=<your node token>

# ── Benchmarks / Docker Hub ──────────────────────────────────────────────
# terminal-bench-2 / harbor task cache (populate via the tb2 onboarding script).
XRLENV_BENCHMARK_CACHE=<your_path>/xrlenv_benchmark_cache

# EvoClaw only: the gitfixed go-zero base image ref in your private registry (no
# default — build it with xrlenv_plugins/benchmarks/evoclaw/go-zero-gitfix.Dockerfile;
# set empty to use the upstream base). See xrlenv_plugins/benchmarks/evoclaw/README.md.
# EVOCLAW_GOZERO_BASE_IMAGE=<registry-host>:5011/go-zero:base-v0.9-gitfix

# Docker Hub PAT for build-plan generators + the mirror's upstream auth. Anon
# pulls are rate-limited (~100/6h) and silently degrade big sweeps; a Pro/Team
# PAT lifts the cap. See docs/technical_details/images/build_plan.md.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# ── Registries (operator; on the box that runs deploy/registry/run-registry-*.sh)
# Three registries, one clear job each — see deploy/registry/README.md:
#   MIRROR  (:5010) pull-through cache of docker.io       run-registry-mirror.sh
#   PRIVATE (:5011) durable, operator-built images        run-registry-private.sh
#   SCRATCH (:5012) build-on-demand (template image_build:), quota-bounded + GC'd
#                   run-registry-scratch.sh — notes/scratch-registry-build-on-demand.md
# Every *_STORAGE path must be a shared (FSx/Lustre/NFS) mount, NEVER the dockerd
# data-root. On a box that LAUNCHES a registry these are REQUIRED and have NO
# default — the old /fsx/home/$USER/... default silently assumed an AWS/FSx
# layout and is wrong elsewhere; the launcher (and the deploy gate) fail loud if
# one is missing. Set each to your shared-store path.

# MIRROR  (deprecated aliases XRLENV_REGISTRY_STORAGE/PORT still work + warn).
XRLENV_MIRROR_REGISTRY_HOST=<your mirror-registry host>
XRLENV_MIRROR_REGISTRY_PORT=5010
XRLENV_MIRROR_REGISTRY_STORAGE=<shared FSx/Lustre/NFS path>   # e.g. /fsx/home/$USER/xrlenv-registry/proxy

# PRIVATE — only for benchmarks that BUILD + push images (seta, TerminalWorld,
# some lhtb tasks). Prebuilt-image benchmarks don't need it.
XRLENV_PRIVATE_REGISTRY_HOST=<your private-registry host>
XRLENV_PRIVATE_REGISTRY_PORT=5011
XRLENV_PRIVATE_REGISTRY_STORAGE=<shared FSx/Lustre/NFS path>   # e.g. /fsx/home/$USER/xrlenv-registry/private
# XRLENV_PRIVATE_REGISTRY_HTTP_SECRET=   # only for a multi-replica/LB deploy

# SCRATCH — build-on-demand: a template's `image_build:` Dockerfile builds here
# on first use (no operator pre-build; bounded so it never grows PRIVATE).
XRLENV_SCRATCH_REGISTRY_HOST=<your scratch-registry host>
XRLENV_SCRATCH_REGISTRY_PORT=5012
XRLENV_SCRATCH_REGISTRY_STORAGE=<shared FSx/Lustre/NFS path>   # e.g. /fsx/home/$USER/xrlenv-registry/scratch
# XRLENV_SCRATCH_REGISTRY_QUOTA_GB=500   # soft cap the GC enforces
# XRLENV_SCRATCH_GC_TTL=72h              # reclaim unreferenced past this age (>> max run)
# XRLENV_SCRATCH_REGISTRY_HTTP_SECRET=   # only for a multi-replica/LB deploy

# ── LLM keys (only for in-container agent examples) ──────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   GOOGLE_API_KEY=   GEMINI_API_KEY=   AWS_BEARER_TOKEN_BEDROCK=

# ── Operator-side (usually set by `xrlenv up` / node deploy, not a consumer .env)
# XRLENV_HOME (above) relocates ALL CP state (state.db, secrets/, runs/) as a
# group — set it to run a dev cluster beside prod on a shared $HOME (prefer it
# over moving $HOME, which would also relocate ~/.ssh, ~/.docker, etc.).
# XRLENV_CONTROL_PLANE=127.0.0.1:50051   # where node-agents dial the CP
# XRLENV_NODE_ID=
# XRLENV_VIEWER_TOKEN=                    # read-only admin panel
# XRLENV_GRPC_SECURE=false               # TLS on the gRPC channel
# XRLENV_DOTENV=off                      # skip this .env auto-load entirely

# ── Node knobs (read by `xrlenv-node serve`; defaults are measured sweet spots)
# XRLENV_RAW_CREATE_CONCURRENCY=4  XRLENV_RAW_DESTROY_CONCURRENCY=4  XRLENV_RAW_ARCHIVE_CONCURRENCY=4
# XRLENV_RAW_SYSBOX_CREATE_CONCURRENCY=1  # serialize sysbox creates (slow pre-register)
# XRLENV_SYSBOX_VENDOR_DIR=/path/to/xrlenv_sysbox_vendor  # REQUIRED for sysbox build tooling (no default); shared storage visible on login + pool nodes
