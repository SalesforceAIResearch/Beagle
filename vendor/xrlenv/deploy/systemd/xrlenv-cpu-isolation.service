[Unit]
Description=XRLEnv CPU isolation — re-establish the delegated xrlenv-shared cpuset cgroup after boot
# cgroups do NOT survive a reboot, so the delegated /sys/fs/cgroup/xrlenv-shared
# created by deploy/node/enable_cpu_isolation.sh is gone after a reboot and the
# (non-root) node agent reverts to non-capable. This oneshot recreates + re-chowns
# it AFTER docker is up (it reads the docker cgroup driver) and BEFORE the agent
# starts (so the agent's NodeHello delegation check passes on the first try).
After=docker.service
Wants=docker.service
Before=xrlenv-node.service
# Only meaningful on a CPU-isolation-enabled node — the marker enable_cpu_isolation.sh writes.
# On a node that was never enabled (or was reverted) the unit is skipped entirely;
# the setup script is ALSO a no-op there (it gates on the cgroupfs driver).
ConditionPathExists=/etc/xrlenv/cpu_isolation.env

[Service]
Type=oneshot
RemainAfterExit=yes
# Installed locally by enable_cpu_isolation.sh so boot does not depend on the
# shared /fsx mount being up.
ExecStart=/etc/xrlenv/setup_shared_cpuset.sh

[Install]
WantedBy=multi-user.target
